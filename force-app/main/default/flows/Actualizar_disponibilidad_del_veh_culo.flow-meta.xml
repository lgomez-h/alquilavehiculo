    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>marcar como disponible</description>
        <name>VRT_Set_Available</name>
        <label>Marcar como disponible</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.VRT_FLG_Available__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>marcar como no disponible</description>
        <name>VRT_Set_Not_Available</name>
        <label>Marcar como no disponible</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.VRT_FLG_Available__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>comprobar si el vehiculo se puede alquilar por su estado</description>
        <name>VRT_Check_Availability</name>
        <label>Comprobar disponibilidad</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>VRT_Set_Not_Available</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>VRT_Available</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.VRT_SEL_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Listo</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.VRT_FLG_NeedsInspection__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>VRT_Set_Available</targetReference>
            </connector>
            <label>Disponible</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Actualizar disponibilidad del vehículo {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Actualizar disponibilidad del vehículo</label>
    <processMetadataValues>
